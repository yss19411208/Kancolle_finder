# 管理画面の設定。 .env にコピーして使う (cp .env.example .env && chmod 600 .env)
GITHUB_REPO=yss19411208/Kancolle_finder
GITHUB_BRANCH=main
# Fine-grained personal access token (対象: Kancolle_finder のみ / Contents: Read and write / Actions: Read and write)
GITHUB_TOKEN=
ADMIN_USER=admin
# ADMIN_PASSWORD_HASH と SECRET_KEY は set_password.py が書き込む
PORT=8787
